<Page x:Class="MarketAO.Pages.SellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="SellPage" Background="#1A1511">

    <Page.Resources>
        <SolidColorBrush x:Key="AlbionGoldBrush"  Color="#C0A060"/>
        <SolidColorBrush x:Key="TextLightBrush"   Color="#C59D76"/>
        <SolidColorBrush x:Key="TextBrightBrush"  Color="#E8D8B5"/>
        <SolidColorBrush x:Key="BorderDarkBrush"  Color="#4D3326"/>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="row" Background="{TemplateBinding Background}"
                                BorderBrush="#4D3326" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#2E251D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Рынок: Продать" FontSize="24"
                   Foreground="{StaticResource TextBrightBrush}"
                   FontWeight="Bold" Margin="0,0,0,14"/>

        <!-- Шапка таблицы -->
        <Border Grid.Row="1" Background="#3A2E24" Height="30" CornerRadius="4"
                Margin="0,0,0,4" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Предмет" VerticalAlignment="Center"
                           Margin="14,0" Foreground="{StaticResource AlbionGoldBrush}"
                           FontWeight="Bold" FontSize="13"/>

                <TextBlock Grid.Column="1" Text="В наличии" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AlbionGoldBrush}" FontWeight="Bold" FontSize="13"/>

            </Grid>
        </Border>

        <ListView x:Name="InventoryList" Grid.Row="2"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- Название и Тир -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="{Binding ItemName}"
                                       Foreground="#E8D8B5" FontWeight="Bold" FontSize="15"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Tier}"
                                       Foreground="#C0A060" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                   Foreground="#E8D8B5" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Button Grid.Column="2" Content="Продать"
                                Tag="{Binding}" Click="SellButton_Click"
                                Width="110" Height="34" HorizontalAlignment="Center" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="#7A3B1E"
                                            CornerRadius="4" BorderBrush="#3D1A0A" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextBlock.Foreground="White" TextBlock.FontWeight="Bold"
                                                          TextBlock.FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#9A4A28"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#5A2B10"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>