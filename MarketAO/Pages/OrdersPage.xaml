<Page x:Class="MarketAO.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="OrdersPage">

    <Page.Resources>
        <SolidColorBrush x:Key="AlbionTitleBrush" Color="#4D3326"/>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#C59D76" BorderThickness="0,0,0,0.5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#A58E77"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#4D3326"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="EditOrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A58463"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#4D3326" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#C59D76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Заказы на покупку" FontSize="20" Foreground="{StaticResource AlbionTitleBrush}" FontWeight="Bold"/>

            <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="Предмет" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="шт." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="Время" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="Цена" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
            </Grid>

            <ListView x:Name="BuyOrdersList" Grid.Row="2" Background="Transparent" BorderThickness="0" d:ItemsSource="{d:SampleData ItemCount=3}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ItemName}" Foreground="#4D3326" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="1" Foreground="#4D3326" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding TimeLeft}" Foreground="#4D3326" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding PriceValue}" Foreground="#456321" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Button Grid.Column="4" Content="Изм." Style="{StaticResource EditOrderButtonStyle}" Click="EditOrder_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Rectangle Grid.Row="1" Height="2" Fill="#A58463" Margin="0,10"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Заказы на продажу" FontSize="20" Foreground="{StaticResource AlbionTitleBrush}" FontWeight="Bold"/>

            <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="Предмет" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="шт." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="Время" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource OrderHeaderStyle}">
                    <TextBlock Text="Цена" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                </Border>
            </Grid>

            <ListView x:Name="SellOrdersList" Grid.Row="2" Background="Transparent" BorderThickness="0" d:ItemsSource="{d:SampleData ItemCount=3}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ItemName}" Foreground="#4D3326" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="1" Foreground="#4D3326" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding TimeLeft}" Foreground="#4D3326" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding PriceValue}" Foreground="#456321" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Button Grid.Column="4" Content="Изм." Style="{StaticResource EditOrderButtonStyle}" Click="EditOrder_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>