<Page x:Class="MarketAO.Pages.BuyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="BuyPage" Background="#1A1511">

    <Page.Resources>
        <SolidColorBrush x:Key="AlbionGoldBrush"  Color="#C0A060"/>
        <SolidColorBrush x:Key="TextLightBrush"   Color="#C59D76"/>
        <SolidColorBrush x:Key="TextBrightBrush"  Color="#E8D8B5"/>
        <SolidColorBrush x:Key="PanelBgBrush"      Color="#25201C"/>
        <SolidColorBrush x:Key="BorderDarkBrush"  Color="#4D3326"/>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="row" Background="{TemplateBinding Background}"
                                BorderBrush="#4D3326" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#2E251D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BuyItemTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                           VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrightBrush}"
                           Margin="14,0" TextWrapping="Wrap"/>

                <TextBlock Grid.Column="2" Text="{Binding Tier}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource AlbionGoldBrush}"
                           FontWeight="Bold" FontSize="15"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" 
            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}" 
               Foreground="{StaticResource TextLightBrush}"
               FontSize="14" FontWeight="Bold"/>
                    <Image Source="/Images/SilverCoin.png" Width="18" Height="18" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="4" Content="Купить"
                        Tag="{Binding}" Click="BuyButton_Click"
                        Width="100" Height="32" HorizontalAlignment="Center" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#456321" CornerRadius="4" BorderBrush="#2A3D10" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.Foreground="White" TextBlock.FontWeight="Bold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#567a29"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Рынок: Купить" FontSize="24" Foreground="{StaticResource TextBrightBrush}"
                   FontWeight="Bold" Margin="0,0,0,14"/>

        <Border Grid.Row="1" Background="{StaticResource PanelBgBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#2D2D2D" BorderBrush="{StaticResource BorderDarkBrush}" 
                        BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center" 
                             Margin="10,5" FontSize="13" TextChanged="SearchBox_TextChanged"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Тир:" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TierFilter" Width="72" SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="T4"/>
                        <ComboBoxItem Content="T5"/>
                        <ComboBoxItem Content="T6"/>
                        <ComboBoxItem Content="T7"/>
                        <ComboBoxItem Content="T8"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#3A2E24" Height="30" CornerRadius="4" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Предмет" VerticalAlignment="Center" Margin="14,0" 
                           Foreground="{StaticResource AlbionGoldBrush}" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Тир" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="{StaticResource AlbionGoldBrush}" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="Цена" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="{StaticResource AlbionGoldBrush}" FontWeight="Bold"/>
            </Grid>
        </Border>

        <ListView x:Name="BuyList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                  ItemTemplate="{StaticResource BuyItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Grid>
</Page>