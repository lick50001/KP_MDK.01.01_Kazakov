<Page x:Class="MarketAO.Pages.CreateOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="CreateOrdersPage" Background="#1A1511">

    <Page.Resources>
        <SolidColorBrush x:Key="TextLightBrush" Color="#C59D76"/>
        <SolidColorBrush x:Key="AlbionGoldBrush" Color="#C0A060"/>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#4D3326"/>

        <Style x:Key="AlbionComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#C59D76"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Gd" Background="{TemplateBinding Background}" 
                                BorderBrush="#4D3326" BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gd" Property="Background" Value="#4D3326"/>
                                <Setter Property="Foreground" Value="#C0A060"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Gd" Property="Background" Value="#C0A060"/>
                                <Setter Property="Foreground" Value="#1A1511"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0A060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AlbionComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="5,0" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#C0A060" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,3,23,3" VerticalAlignment="Center" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#2D2D2D" 
                                            BorderBrush="#C0A060" BorderThickness="1"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AllItemsTemplate">
            <Border BorderBrush="#4D3326" BorderThickness="0,0,0,1" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" Background="#2D2D2D" 
                            BorderBrush="#C0A060" BorderThickness="1" CornerRadius="4">
                        <Image Source="{Binding IconPath}" Margin="3"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="{Binding ItemName}" FontSize="14" Foreground="#C59D76" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#634435"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding TierString}" VerticalAlignment="Center" 
                               HorizontalAlignment="Center" Foreground="#C0A060" FontWeight="Bold"/>

                    <Button Grid.Column="3" Content="Выбрать" Height="28" Width="100" Background="#4D3326" Foreground="#C59D76"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="База предметов" FontSize="26" Foreground="{StaticResource TextLightBrush}" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#25201C" Padding="10" CornerRadius="5" Margin="0,0,0,15" BorderBrush="#3D3D3D" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource DarkBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox" 
             Background="Transparent" 
             BorderThickness="0" 
             Foreground="White" 
             VerticalAlignment="Center" 
             Margin="10,0"
             TextChanged="SearchBox_TextChanged"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Text="Тир:" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="TierFilter" Width="70" SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="T4"/>
                        <ComboBoxItem Content="T5"/>
                        <ComboBoxItem Content="T6"/>
                        <ComboBoxItem Content="T7"/>
                        <ComboBoxItem Content="T8"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Уровень:" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="EnchantmentFilter" Width="70" SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content=".0"/>
                        <ComboBoxItem Content=".1"/>
                        <ComboBoxItem Content=".2"/>
                        <ComboBoxItem Content=".3"/>
                        <ComboBoxItem Content=".4"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <ListView x:Name="AllItemsList" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                  ItemTemplate="{StaticResource AllItemsTemplate}"
                  d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="◀" Width="35" Height="35" Background="{StaticResource DarkBgBrush}" Foreground="{StaticResource AlbionGoldBrush}"/>
            <Border Background="{StaticResource AlbionGoldBrush}" Width="35" Height="35" Margin="10,0" CornerRadius="2">
                <TextBlock Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#1A1511" FontWeight="Bold"/>
            </Border>
            <Button Content="▶" Width="35" Height="35" Background="{StaticResource DarkBgBrush}" Foreground="{StaticResource AlbionGoldBrush}"/>
        </StackPanel>
    </Grid>
</Page>