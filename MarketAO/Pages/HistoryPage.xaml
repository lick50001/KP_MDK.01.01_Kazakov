<Page x:Class="MarketAO.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HistoryPage"
      Background="#1A1511">

    <Page.Resources>
        <SolidColorBrush x:Key="AlbionGoldBrush" Color="#C0A060"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="#C59D76"/>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MarketItemTemplate">
            <Border BorderBrush="#4D3326" BorderThickness="0,0,0,1" Padding="5,10">
                <Grid x:Name="ItemGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="64" Height="64" Background="#2D2D2D" CornerRadius="4" 
                            BorderBrush="{StaticResource AlbionGoldBrush}" BorderThickness="1.5">
                        <Image Source="{Binding IconPath}" Margin="4"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding ItemName}" VerticalAlignment="Center" 
                               FontSize="16" Foreground="{StaticResource TextLightBrush}" 
                               Margin="15,0" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2" Text="{Binding TimeLeft}" VerticalAlignment="Center" 
                               HorizontalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Images/SilverCoin.png" Width="18" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PriceValue}" Foreground="{StaticResource TextLightBrush}" FontSize="15"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="{Binding ActionText}" Width="115" Height="38" HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#8B0000" CornerRadius="16" BorderBrush="#1A1511" BorderThickness="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White" TextBlock.FontWeight="Bold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Завершенные операции" FontSize="28" Foreground="{StaticResource TextLightBrush}" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#C59D76" Height="35" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Предмет" VerticalAlignment="Center" Margin="15,0" Foreground="#4D3326" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Время" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4D3326" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="Цена" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4D3326" FontWeight="Bold"/>
            </Grid>
        </Border>

        <ListView x:Name="HistoryList" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                  ItemTemplate="{StaticResource MarketItemTemplate}" 
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="Примечание: предметы, пролежавшие на рынке более 60 дней, удаляются из игры." 
                       VerticalAlignment="Center" FontSize="12" Foreground="#8A735A" Margin="0,0,25,0"/>
            <Button Content="Взять все" Width="130" Height="40" Background="#8B0000" Foreground="White" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Page>