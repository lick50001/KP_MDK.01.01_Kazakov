<Window x:Class="Kazakov_KP_01._01.Pages.FunctionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FunctionWindow" Height="580" Width="520"
        Background="Transparent" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        >
    <Border CornerRadius="20" Background="#1A1C24"
            BorderBrush="#2D313A" BorderThickness="1"
            MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.8" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="12" Background="#252833" Margin="0,0,16,0">
                        <TextBlock x:Name="TxtIcon" Text="⚙" FontSize="24" Foreground="#00FFC2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="Название функции" Foreground="White"
                               FontSize="24" FontWeight="Bold" FontFamily="Exo 2" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Click="CloseBtn_Click" Content="×" Background="Transparent"
                        Foreground="#6E7485" Width="30" Height="30" FontSize="20"
                        BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"/>
            </Grid>

            <Border Grid.Row="1" x:Name="StatusBadge" CornerRadius="8" Padding="12,6"
                    HorizontalAlignment="Left" Background="#26FF4D4D" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FF4D4D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Остановлено" Foreground="#FF4D4D"
                               FontSize="14" FontFamily="Exo 2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#252833" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Описание" Foreground="#6E7485" FontSize="13"
                                   FontFamily="Exo 2" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtDescription" Text="Описание функции..." Foreground="White"
                                   FontSize="15" FontFamily="Exo 2" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,20"/>

                        <Border BorderBrush="#2D313A" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Управление клавишами" Foreground="#6E7485" FontSize="13"
                                           FontFamily="Exo 2" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtHotkeys" Text="Включить: [F6]  |  Выключить: [F7]" Foreground="#00FFC2"
                                           FontSize="14" FontFamily="Exo 2" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnStart" Grid.Column="0" Content="▶  Запустить" Click="BtnStart_Click"
                        Background="#00FFC2" Foreground="#0B0C15" FontSize="16" FontWeight="Bold"
                        FontFamily="Exo 2" Height="48" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnStop" Grid.Column="1" Content="■  Остановить" Click="BtnStop_Click"
                        Background="#26FF4D4D" Foreground="#FF4D4D" FontSize="16" FontWeight="Bold"
                        FontFamily="Exo 2" Height="48" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>