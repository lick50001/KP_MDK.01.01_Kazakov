<Page x:Class="Kazakov_KP_01._01.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1500"
      Title="AdminPage"
      Loaded="AdminPage_Loaded">

    <Grid Margin="0,0,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Статистика -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="#1A1C24" CornerRadius="12" BorderBrush="#33FFFF" BorderThickness="0.4" 
                    Padding="24,16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Всего пользователей" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2"/>
                    <TextBlock x:Name="txTotalUsers" Text="0" Foreground="White" FontSize="32" 
                               FontWeight="Bold" FontFamily="Exo 2"/>
                </StackPanel>
            </Border>
            <Border Background="#1A1C24" CornerRadius="12" BorderBrush="#33FFFF" BorderThickness="0.4" 
                    Padding="24,16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Активных" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2"/>
                    <TextBlock x:Name="txActiveUsers" Text="0" Foreground="#00FFC2" FontSize="32" 
                               FontWeight="Bold" FontFamily="Exo 2"/>
                </StackPanel>
            </Border>
            <Border Background="#1A1C24" CornerRadius="12" BorderBrush="#33FFFF" BorderThickness="0.4" 
                    Padding="24,16">
                <StackPanel>
                    <TextBlock Text="Заблокированных" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2"/>
                    <TextBlock x:Name="txBannedUsers" Text="0" Foreground="#FF4D4D" FontSize="32" 
                               FontWeight="Bold" FontFamily="Exo 2"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Поиск + кнопка добавить -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1A1C24" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" 
                    Padding="16,0" Height="44">
                <Grid>
                    <TextBlock Text="🔍  Поиск по имени..." Foreground="#6E7485" FontSize="15" 
                               FontFamily="Exo 2" VerticalAlignment="Center"
                               x:Name="txSearchHint"/>
                    <TextBox x:Name="txSearch" Background="Transparent" BorderThickness="0" 
                             Foreground="White" FontSize="15" FontFamily="Exo 2" 
                             VerticalAlignment="Center" CaretBrush="White"
                             TextChanged="txSearch_TextChanged"
                             GotFocus="txSearch_GotFocus"
                             LostFocus="txSearch_LostFocus"/>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="+ Добавить" Click="AddUser_Click"
                    Background="#00FFC2" Foreground="#0B0C15" FontSize="15" FontWeight="Bold"
                    FontFamily="Exo 2" Height="44" Padding="20,0" Margin="12,0,0,0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Список пользователей -->
        <Border Grid.Row="2" Background="#1A1C24" CornerRadius="15" 
                BorderBrush="#33FFFF" BorderThickness="0.4">
            <Grid>
                <!-- Заголовок таблицы -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ID" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Имя пользователя" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Роль" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Статус" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Действия" Foreground="#6E7485" FontSize="13" FontFamily="Exo 2" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

                <Rectangle Grid.Row="0" Height="1" Fill="#33FFFFFF" VerticalAlignment="Bottom" Margin="20,0"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="UsersContainer" Margin="20,8,20,16"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>