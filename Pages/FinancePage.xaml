<Page x:Class="Kazakov_KP_01._01.Pages.FinancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1500"
      Title="FinancePage"
      Loaded="FinancePage_Loaded">

    <Grid Margin="0,0,30,0" HorizontalAlignment="Left" Width="1470">
        <Grid.ColumnDefinitions>
            <!-- Вернули исходную ширину колонки, чтобы правая часть не двигалась -->
            <ColumnDefinition Width="724"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <!-- Плашка уменьшена до 650 и прижата влево. Логи стали уже, справа от них появился зазор -->
            <Border Width="650" HorizontalAlignment="Left" BorderBrush="#FF33FFFF" Margin="0 0 0 0" BorderThickness="0.42" Background="#1A1C24" CornerRadius="15">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <DockPanel Margin="30">
                        <TextBlock DockPanel.Dock="Top"
                                 Text="> История операций"
                                 FontSize="24"
                                 FontWeight="Bold"
                                 Foreground="#FFFFFF"
                                 Margin="0,0,0,15"
                                 FontFamily="Exo 2"/>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="FinanceLogsContainer"/>
                        </ScrollViewer>
                    </DockPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Правая колонка теперь стоит идеально на своем старом месте -->
        <Grid Grid.Column="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="0 -228 0 0" HorizontalAlignment="Center">
                    <TextBlock Text="Общий профит:" Foreground="#6E7485" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 40" FontFamily="Exo 2"/>
                    <TextBlock x:Name="TxtTotalProfit" Text="+$0" Foreground="#00FFC2" FontSize="112" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Exo 2">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00FFC2" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Page>