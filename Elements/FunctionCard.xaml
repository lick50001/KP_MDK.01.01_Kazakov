<UserControl x:Class="Kazakov_KP_01._01.Elements.FunctionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="470" Height="315">
    <Border Background="#1A1C24" CornerRadius="15" BorderBrush="#FF33FFFF" BorderThickness="0.42"
            Cursor="Hand" MouseLeftButtonUp="Card_Click" x:Name="MainBorder">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Иконка + статус -->
            <Grid Grid.Row="0">
                <Border Width="56" Height="56" CornerRadius="14" Background="#252833" HorizontalAlignment="Left">
                    <TextBlock x:Name="TxtIcon" Text="⚙" FontSize="26" Foreground="#00FFC2"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="StatusBadge" CornerRadius="8" Padding="10,5"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="#26FF4D4D">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF4D4D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Остановлено" Foreground="#FF4D4D"
                                   FontSize="13" FontFamily="Exo 2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Заголовок + описание -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,0">
                <TextBlock x:Name="TxtTitle" Text="Название функции" Foreground="White"
                           FontSize="22" FontWeight="Bold" FontFamily="Exo 2" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtDescription" Text="Описание функции..." Foreground="#6E7485"
                           FontSize="15" FontFamily="Exo 2" TextWrapping="Wrap" MaxHeight="90" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Подсказка -->
            <Grid Grid.Row="2">
                <TextBlock Text="Нажмите, чтобы открыть →" Foreground="#6E7485"
                           FontSize="13" FontFamily="Exo 2" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>